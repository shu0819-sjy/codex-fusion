* text=auto

# Shell scripts keep CRLF on Windows
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Sources use LF
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Binaries
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.wasm binary
